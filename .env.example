# Brand Intelligence Agent - Environment Configuration
# Copy this file to .env and fill in your API keys

# ── Firecrawl (website crawling & scraping) ──
# Get your API key: https://firecrawl.dev
FIRECRAWL_API_KEY=

# ── Tavily (AI-powered search) ──
# Get your API key: https://tavily.com
TAVILY_API_KEY=

# ── DataForSEO (SEO analytics) ──
# Get credentials: https://dataforseo.com
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── LLM Provider ──
# Options: "anthropic" or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# ── General ──
OUTPUT_DIR=./reports
LOG_LEVEL=INFO
